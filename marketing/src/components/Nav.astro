---
// Site header, present on every page via BaseLayout.astro.
//
// #markets stays a same-page anchor because that section only exists on
// the homepage (index.astro) — there's no dedicated "/markets" page to
// link to. (The homepage also still has #how-it-works and #products
// sections — neither is in this nav directly any more: #how-it-works
// was removed from the nav outright per the user's request, though the
// section itself is untouched on the page; #products is reachable via
// the hero's "Explore the bots" button instead.)
//
// Security now links to a real page (security.astro) instead of the
// homepage's #security anchor, same treatment as About/Learn below — the
// homepage's own #security section stays as a shorter teaser and links
// down to the full page itself.
//
// Learn, AI Hub, Referral Program, and Help Center DO have real pages
// (learn.astro, ai-hub.astro, referrals.astro, help-center.astro), same
// as About/Terms/Privacy above — real hrefs, not anchors. AI Hub,
// Referral Program, and Help Center are grouped under a "More" dropdown
// rather than three more top-level links, same reasoning and same
// CSS-only hover/focus mechanism as the "Legal" dropdown further down —
// see its comment for how the dropdown itself works.
//
// About, Terms and Privacy DO have real pages now (about.astro, terms.astro,
// privacy.astro), so they're linked with real hrefs below rather than
// anchors. Terms + Privacy are grouped under a "Legal" dropdown instead of
// two separate top-level links, per the user's choice — see the qx-dropdown
// markup/CSS below. If a third legal doc is ever added (e.g. a cookie
// policy), just add one more <a> inside .qx-dropdown-menu; the dropdown
// sizes itself automatically.
//
// Below 720px, .qx-links (all the real nav content — every link plus the
// two dropdowns) stops being a horizontal row and becomes a hidden
// slide-down panel instead, opened by the hamburger button
// (.qx-menu-toggle) that only exists in the DOM for that same width. This
// is the one bit of this file that needs real JavaScript rather than
// CSS-only hover/focus — see the <script> at the bottom for why (short
// version: iOS Safari doesn't focus a plain <button> on tap, so the
// desktop dropdowns' :focus-within trick alone never fires there).
const APP_URL = "https://trading.onquantex.com";
---

<header class="qx-nav">
  <div class="qx-container qx-nav-inner">
    <a href="/" class="qx-brand" aria-label="Quantex home">
      <img src="/favicon.svg" alt="" width="28" height="28" />
      <span>Quantex</span>
    </a>

    <nav class="qx-links" id="qx-mobile-nav" aria-label="Primary">
      <a href="#markets">Markets</a>
      <a href="/security">Security</a>
      <a href="/about">About</a>
      <a href="/learn">Learn</a>

      <!--
        The "More" dropdown — same CSS-only hover/focus mechanism as
        "Legal" just below (see its comment for the mechanics), just a
        different trigger label and menu items.
      -->
      <div class="qx-dropdown">
        <button
          type="button"
          class="qx-dropdown-trigger"
          aria-haspopup="true"
          aria-expanded="false"
        >
          More
          <svg
            class="qx-dropdown-chevron"
            width="10"
            height="10"
            viewBox="0 0 10 10"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M2 3.5L5 6.5L8 3.5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <div class="qx-dropdown-menu">
          <div class="qx-dropdown-menu-inner">
            <a href="/ai-hub">AI Hub</a>
            <a href="/referrals">Referral Program</a>
            <a href="/help-center">Help Center</a>
          </div>
        </div>
      </div>

      <!--
        The "Legal" dropdown. It's a plain CSS hover/focus dropdown — no
        JavaScript involved — which keeps it consistent with the rest of
        this static site (nothing else here uses client-side JS). Two
        things make it open:
          1. `.qx-dropdown:hover` — mouse hovers anywhere in the wrapper
             (trigger button OR the menu itself, since the menu is a child
             of the same wrapper).
          2. `.qx-dropdown:focus-within` — keyboard users Tab onto the
             trigger button or into a menu link; `:focus-within` matches
             as long as focus is ANYWHERE inside .qx-dropdown, so tabbing
             from the button into "Terms of Service" doesn't close it.
        The trigger is a <button>, not an <a>, because it doesn't navigate
        anywhere itself — it only reveals the two real links underneath.
        aria-haspopup/aria-expanded describe that relationship to screen
        readers (aria-expanded is static "false" here since there's no JS
        to flip it — CSS-only dropdowns can't update ARIA state on
        hover/focus, only on click — but the menu links are still reachable
        and announced normally via Tab, so nothing is hidden from a
        screen-reader user, it's just not announced as "expanded").
      -->
      <div class="qx-dropdown">
        <button
          type="button"
          class="qx-dropdown-trigger"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Legal
          <svg
            class="qx-dropdown-chevron"
            width="10"
            height="10"
            viewBox="0 0 10 10"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M2 3.5L5 6.5L8 3.5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <div class="qx-dropdown-menu">
          <div class="qx-dropdown-menu-inner">
            <a href="/terms">Terms of Service</a>
            <a href="/privacy">Privacy Policy</a>
          </div>
        </div>
      </div>
    </nav>

    <!--
      Only present visually below 720px (see .qx-menu-toggle in the CSS) —
      above that width .qx-links is already a normal horizontal row and
      this button isn't needed. It's still in the DOM at every width so
      there's nothing conditionally rendered server-side to keep in sync.
    -->
    <button
      type="button"
      class="qx-menu-toggle"
      aria-expanded="false"
      aria-controls="qx-mobile-nav"
      aria-label="Menu"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>

    <div class="qx-actions">
      <a class="qx-btn-secondary" href={`${APP_URL}/login`}>Log in</a>
      <a class="qx-btn-primary" href={`${APP_URL}/signup`}>Trade Now</a>
    </div>
  </div>
</header>

<style>
  .qx-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--cream-base) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--cream-line);
  }
  .qx-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-24);
    height: 72px;
  }
  .qx-brand {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    color: var(--ink-base);
    flex-shrink: 0;
  }
  .qx-links {
    display: flex;
    align-items: center;
    gap: var(--space-24);
    flex: 1;
    justify-content: center;
  }
  .qx-links a {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }
  .qx-links a:hover {
    color: var(--teal-base);
  }

  /* Wrapper that positions the dropdown menu relative to its trigger.
     `position: relative` here is what lets the menu's `position: absolute`
     below anchor to THIS box instead of the whole page. */
  .qx-dropdown {
    position: relative;
  }
  /* The "Legal" button itself. Reset button-specific defaults (border,
     background) so it visually matches the plain <a> links either side of
     it — font/color/size are inherited from `.qx-links` via `font: inherit`
     and `color: inherit` rather than repeated here. */
  .qx-dropdown-trigger {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0;
    background: none;
    border: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .qx-dropdown-trigger:hover {
    color: var(--teal-base);
  }
  /* Chevron flips upside-down while the dropdown is open, as a visual cue.
     Change `rotate(180deg)` to e.g. `rotate(90deg)` for a sideways-turning
     arrow instead. */
  .qx-dropdown-chevron {
    transition: transform 0.15s ease;
  }
  .qx-dropdown:hover .qx-dropdown-chevron,
  .qx-dropdown:focus-within .qx-dropdown-chevron {
    transform: rotate(180deg);
  }
  /* The dropdown panel. It's always in the DOM (so keyboard Tab can reach
     its links) but visually hidden via opacity/visibility until the
     wrapper is hovered or has focus inside it — see the two rules below
     this one. `pointer-events: none` while closed stops it from silently
     eating hover/clicks that should pass through to whatever's behind it. */
  .qx-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    /* Padding-top (not margin-top) closes the gap between trigger and menu
       WITHOUT creating a dead zone the mouse can slip through on the way
       down — the invisible padding is still "inside" .qx-dropdown-menu, so
       hovering it keeps :hover active on the parent .qx-dropdown. */
    padding-top: var(--space-8);
    display: flex;
    flex-direction: column;
    min-width: 180px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .qx-dropdown:hover .qx-dropdown-menu,
  .qx-dropdown:focus-within .qx-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  /* Inner box that actually looks like a card — separated from
     .qx-dropdown-menu so the padding-top spacer above isn't part of the
     visible card (it'd otherwise show as dead space inside the border). */
  .qx-dropdown-menu-inner {
    display: flex;
    flex-direction: column;
    background: var(--cream-deep);
    border: 1px solid var(--cream-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-dropdown);
    padding: var(--space-4);
  }
  .qx-dropdown-menu a {
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-soft);
    white-space: nowrap;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .qx-dropdown-menu a:hover {
    color: var(--teal-base);
    background: var(--cream-line);
  }

  .qx-actions {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    flex-shrink: 0;
    /* Keeps the buttons from ever sitting flush against whatever's to
       their left — on desktop that's .qx-links (which already has its
       own gap from .qx-nav-inner), on mobile it's the hamburger button
       right next to it, which had no breathing room of its own before. */
    margin-left: var(--space-10);
  }

  /* Hidden by default (desktop) — only shown inside the 720px media query
     below. A plain reset button, same approach as .qx-dropdown-trigger:
     no visible border/background of its own, just the SVG icon inside. */
  .qx-menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    color: var(--ink-base);
    cursor: pointer;
    flex-shrink: 0;
  }
  .qx-menu-toggle:hover {
    color: var(--teal-base);
  }

  @media (max-width: 720px) {
    /* Shorter bar and smaller wordmark to make room for the hamburger —
       the 72px height was sized for the full desktop link row. */
    .qx-nav-inner {
      height: 56px;
    }
    .qx-brand {
      font-size: 17px;
    }
    .qx-brand img {
      width: 24px;
      height: 24px;
    }
    .qx-menu-toggle {
      display: inline-flex;
    }

    /* .qx-links becomes a slide-down panel instead of a horizontal row:
       hidden by default (this rule), shown only once the hamburger above
       adds .qx-nav-open to the <header> (see .qx-nav.qx-nav-open below
       and the <script> at the end of this file). It's positioned to hang
       directly under the header, full width, as its own scrollable card
       rather than squeezed into the header's own 56px height. */
    .qx-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      max-height: calc(100vh - 56px);
      overflow-y: auto;
      background: var(--cream-deep);
      border-bottom: 1px solid var(--cream-line);
      box-shadow: var(--shadow-dropdown);
      padding: var(--space-8);
    }
    .qx-nav.qx-nav-open .qx-links {
      display: flex;
    }
    .qx-links a {
      padding: var(--space-10) var(--space-8);
      border-radius: var(--radius-sm);
    }
    .qx-links a:hover {
      background: var(--cream-line);
    }

    /* The "More"/"Legal" dropdowns switch from a floating hover panel to
       an inline accordion that stacks underneath their own trigger —
       floating them absolutely, centered under a button, would push them
       half off-screen inside a full-width mobile panel. Opened by tapping
       the trigger, same as before, but via a real click listener (see the
       <script> below) rather than :hover/:focus-within — iOS Safari does
       not focus a plain <button> on tap, so :focus-within alone never
       fires there and the menu would never open on an iPhone. */
    .qx-dropdown-trigger {
      width: 100%;
      justify-content: space-between;
      padding: var(--space-10) var(--space-8);
      border-radius: var(--radius-sm);
    }
    .qx-dropdown-trigger:hover {
      background: var(--cream-line);
    }
    .qx-dropdown-menu {
      position: static;
      transform: none;
      padding-top: 0;
      display: none;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      min-width: 0;
    }
    .qx-dropdown.qx-open .qx-dropdown-menu {
      display: flex;
    }
    .qx-dropdown.qx-open .qx-dropdown-chevron {
      transform: rotate(180deg);
    }
    .qx-dropdown-menu-inner {
      border: none;
      box-shadow: none;
      padding: 0 0 0 var(--space-8);
    }
  }
  @media (max-width: 400px) {
    /* Below ~400px even "Log in" + "Trade Now" side by side gets tight —
       shrink the buttons' own padding rather than drop "Log in"
       entirely, so both stay one tap away. */
    .qx-actions {
      gap: var(--space-8);
    }
    /* No :global() needed — these two <a> tags are part of THIS
       component's own template above, so Astro already scopes them to
       Nav.astro like everything else here. */
    .qx-actions .qx-btn-primary,
    .qx-actions .qx-btn-secondary {
      padding: var(--space-6) var(--space-10);
      font-size: 14px;
    }
  }
</style>

<script>
  // Mobile hamburger menu. The only real client-side interactivity in
  // this component — everything else (the desktop dropdowns) is
  // deliberately CSS-only hover/focus, see their comments above for why.
  // This exists because there's no CSS-only way to open/close an
  // absolutely-positioned panel from a button tap, and because iOS Safari
  // specifically doesn't focus a plain <button> on tap (so :focus-within
  // never fires there), which rules out reusing the desktop dropdown
  // trick for the "More"/"Legal" menus at this width too.
  const nav = document.querySelector(".qx-nav");
  const menuToggle = document.querySelector<HTMLButtonElement>(".qx-menu-toggle");
  const mobileNav = document.getElementById("qx-mobile-nav");

  menuToggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("qx-nav-open") ?? false;
    menuToggle.setAttribute("aria-expanded", String(isOpen));
  });

  // Accordion behavior for the "More"/"Legal" triggers. Guarded to only
  // run below 720px so it never interferes with the desktop hover/focus
  // dropdowns above that width — this listener still fires on a desktop
  // click, it just no-ops there.
  document.querySelectorAll<HTMLButtonElement>(".qx-dropdown-trigger").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      if (window.innerWidth > 720) return;
      const dropdown = trigger.closest(".qx-dropdown");
      const isOpen = dropdown?.classList.toggle("qx-open") ?? false;
      trigger.setAttribute("aria-expanded", String(isOpen));
    });
  });

  // Closes the whole mobile panel after tapping any real link inside it
  // (including ones inside the More/Legal accordions), so navigating —
  // or jumping to a same-page anchor like #markets, which wouldn't
  // otherwise trigger a page load to reset anything — doesn't leave the
  // panel sitting open over the page you land on.
  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      nav?.classList.remove("qx-nav-open");
      menuToggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
