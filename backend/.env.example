ENVIRONMENT=development

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (cache, pub-sub, Celery broker)
REDIS_URL=

# Resend (transactional email — OTP codes, deposit/withdrawal/KYC notifications).
# Not the same credential as Supabase's SMTP settings — this is used to call
# Resend's API directly from the backend, bypassing Supabase's own mail sending.
RESEND_API_KEY=
# Sandbox sender until a domain is bought and verified in Resend.
RESEND_FROM_EMAIL=Quantex <onboarding@resend.dev>

# Frontend origin allowed for CORS in dev
FRONTEND_ORIGIN=http://localhost:5173

# HD wallet master seed (BIP-39 mnemonic, 24 words) — derives every user's
# per-network deposit address (TRC-20/Base/Polygon). PRODUCTION VALUE MUST BE
# GENERATED OFFLINE (air-gapped) and set only in Railway's secrets, never here,
# never committed. Local dev may use a throwaway generated mnemonic that holds
# no real funds — never reuse a dev seed for anything that touches mainnet.
MASTER_WALLET_SEED=

# TronGrid — create a free account at https://www.trongrid.io, then an API key
# under your dashboard. Currently pointed at the Nile TESTNET for development;
# switch TRONGRID_BASE_URL to https://api.trongrid.io for mainnet later.
TRONGRID_API_KEY=
TRONGRID_BASE_URL=https://nile.trongrid.io

# Alchemy — create a free account at https://www.alchemy.com, then one app per
# network. Paste each app's full HTTPS RPC URL (the API key is embedded in the
# path). Currently TESTNET apps (Base Sepolia / Polygon Amoy); create separate
# mainnet apps later rather than reusing these when that day comes.
ALCHEMY_BASE_RPC_URL=
ALCHEMY_POLYGON_RPC_URL=

# Signing secret for admin session tokens (separate from Supabase Auth —
# see app/config.py's comment on admin_jwt_secret). Generate a real value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_JWT_SECRET=

# Tron gas/staking wallet (deposit consolidation, Module 2) — a standalone
# account, NOT derived from MASTER_WALLET_SEED, that stakes TRX for Energy
# and delegates it to a deposit address right before sweeping it. Generate a
# fresh keypair for this — never reuse MASTER_WALLET_SEED's derived keys or
# a testnet key on mainnet. Raw 64-char hex private key. For testnet, fund
# the resulting address from the Nile faucet: https://nileex.io/join/getJoinPage
TRON_GAS_WALLET_PRIVATE_KEY=

# EVM relayer wallet (deposit consolidation, Module 3) — one standalone
# account, shared by Base and Polygon, that submits each EIP-3009
# transferWithAuthorization call and pays its own gas; deposit addresses
# never need ETH/MATIC of their own. Generate a fresh keypair (e.g.
# `python -c "from eth_account import Account; a = Account.create(); print(a.key.hex()); print(a.address)"`).
# For testnet, fund it from a Base Sepolia and a Polygon Amoy faucet.
EVM_RELAYER_PRIVATE_KEY=
