---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
---

<BaseLayout
  title="Blog"
  description="Notes on how Quantex is built: the bot strategies, the security boundaries, and the reasoning behind both."
>
  <section class="qx-section">
    <div class="qx-container">
      <h1>Blog</h1>
      <p class="qx-section-sub qx-blog-intro">Notes on how Quantex is built, and why.</p>

      <div class="qx-blog-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="qx-blog-card">
            <time datetime={post.data.publishDate.toISOString()}>
              {dateFormatter.format(post.data.publishDate)}
            </time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="qx-blog-read">Read the post &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .qx-section {
    padding: var(--space-48) 0;
  }
  .qx-section h1 {
    font-size: 36px;
    color: var(--ink-base);
    text-align: center;
  }
  .qx-blog-intro {
    margin-top: var(--space-8);
    text-align: center;
    color: var(--ink-soft);
  }
  .qx-blog-grid {
    margin-top: var(--space-32);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-16);
    max-width: 880px;
    margin-left: auto;
    margin-right: auto;
  }
  .qx-blog-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    background: var(--cream-deep);
    border: 1px solid var(--cream-line);
    border-radius: var(--radius-xl);
    padding: var(--space-24);
    transition: border-color 0.15s ease;
  }
  .qx-blog-card:hover {
    border-color: var(--teal-base);
  }
  .qx-blog-card time {
    font-family: var(--font-data);
    font-size: 12px;
    color: var(--ink-soft);
  }
  .qx-blog-card h2 {
    font-size: 19px;
    color: var(--ink-base);
  }
  .qx-blog-card p {
    font-size: 14px;
    color: var(--ink-soft);
    flex: 1;
  }
  .qx-blog-read {
    font-size: 13px;
    font-weight: 600;
    color: var(--teal-base);
  }

  @media (max-width: 720px) {
    .qx-blog-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .qx-section {
      padding: var(--space-32) 0;
    }
    .qx-section h1 {
      font-size: 28px;
    }
    .qx-blog-card {
      padding: var(--space-16);
    }
  }
</style>
