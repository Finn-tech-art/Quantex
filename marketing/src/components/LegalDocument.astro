---
// Shared body for /terms and /privacy: a heading, then the actual PDF
// (generated by marketing/scripts/generate_legal_pdfs.py) embedded inline
// via <object>. <object> is used rather than <iframe> specifically because
// it supports real fallback content between the open/close tags -- on a
// browser or device that can't render a PDF inline (this varies a lot on
// mobile), the fallback paragraph below renders instead of a blank box,
// with a direct download/open link. The same link also appears above the
// embed unconditionally, since "just open the PDF" is the more reliable
// path on mobile even when the inline embed happens to work.
interface Props {
  title: string;
  pdfPath: string;
  effectiveDate: string;
}
const { title, pdfPath, effectiveDate } = Astro.props;
---

<section class="qx-legal">
  <div class="qx-container">
    <h1>{title}</h1>
    <p class="qx-legal-meta">
      Effective {effectiveDate} &middot;{" "}
      <a href={pdfPath} target="_blank" rel="noopener">Open as PDF</a>
    </p>

    <object data={pdfPath} type="application/pdf" class="qx-legal-embed">
      <p class="qx-legal-fallback">
        Your browser can't display the PDF inline.{" "}
        <a href={pdfPath} target="_blank" rel="noopener">Open {title} in a new tab</a>{" "}
        instead.
      </p>
    </object>
  </div>
</section>

<style>
  .qx-legal {
    padding: var(--space-48) 0;
  }
  .qx-legal h1 {
    font-size: 32px;
    color: var(--ink-base);
  }
  .qx-legal-meta {
    margin-top: var(--space-8);
    margin-bottom: var(--space-24);
    color: var(--ink-soft);
    font-size: 14px;
  }
  .qx-legal-meta a {
    color: var(--teal-base);
    font-weight: 600;
  }
  .qx-legal-embed {
    width: 100%;
    /* Tall enough to read a full page of the PDF without scrolling twice
       (once in the embed, once on the page) on most laptop screens. */
    height: 80vh;
    min-height: 500px;
    border: 1px solid var(--cream-line);
    border-radius: var(--radius-lg);
    background: #fff;
  }
  .qx-legal-fallback {
    padding: var(--space-24);
    text-align: center;
    color: var(--ink-soft);
  }
  .qx-legal-fallback a {
    color: var(--teal-base);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .qx-legal-embed {
      /* Inline PDF rendering is unreliable enough on mobile browsers that
         a short embed plus the two "open as PDF" links above/inside it is
         more useful than a tall box that may just render blank. */
      height: 50vh;
    }
  }
</style>
